{
  "name": "@triad-chess/engine",
  "version": "0.1.0",
  "private": true,
  "description": "Framework-independent rules engine for Triad Chess",
  "engines": {
    "node": "20.x"
  },
  "type": "module",
  "main": "./src/runtime.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/runtime.js",
      "default": "./src/runtime.js"
    }
  },
  "files": [
    "src",
    "tests",
    "README.md",
    "tsconfig.json"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node tests/engine.test.mjs"
  }
}
