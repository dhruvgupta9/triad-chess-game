# Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=3001

# Browser/client URLs. Keep these aligned with the ports exposed by the server
# and the client dev server.
CLIENT_PORT=5173
PUBLIC_API_URL=http://localhost:3001
PUBLIC_WS_URL=ws://localhost:3001
VITE_API_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001
CORS_ORIGIN=http://localhost:5173

# Game defaults
DEFAULT_AI_LEVEL=human
NEUTRAL_ELIMINATED_PIECES=disappear

# Optional remote AI provider. Leave blank to use the local engine AI.
AI_PROVIDER=local
AI_MODEL=
AI_API_KEY=
